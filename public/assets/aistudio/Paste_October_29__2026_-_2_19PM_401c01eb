                </div>
                <div class="absolute top-20 z-10 w-24 h-20 rounded-lg overflow-hidden border-2 border-indigo-400 shadow-md bg-white">
                    <img src="${inf.image}" class="w-full h-full object-cover">
                </div>
                ${shoe ? `<div class="absolute bottom-2 z-30 w-16 h-10 rounded overflow-hidden border-2 border-indigo-400 shadow-md bg-white"><img src="${shoe.image}" class="w-full h-full object-cover"></div>` : ''}
            `;

            resDiv.classList.remove('hidden');
        }

        function unlockSaveOutfit() {
            const statusElem = document.getElementById('save-status');
            if(statusElem) {
                statusElem.innerText = '✅ ¡Outfit guardado con éxito! Gracias por seguir a @yonimikel';
                statusElem.className = 'italic text-emerald-400 font-semibold';
            }
        }
    </script>
</body>
</html>