        function compressImage(file) {
            return new Promise((resolve) => {
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = function(e) {
                    const img = new Image();
                    img.src = e.target.result;
                    img.onload = function() {
                        const canvas = document.createElement('canvas');
                        const MAX = 180;
                        let w = img.width, h = img.height;
                        if (w > h) { if (w > MAX) { h *= MAX / w; w = MAX; } }
                        else { if (h > MAX) { w *= MAX / h; h = MAX; } }
                        canvas.width = w; canvas.height = h;
                        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                        resolve(canvas.toDataURL('image/jpeg', 0.25));
                    }
                }
            });
        }

        async function processImages(e) {
            const files = e.target.files;
            if(!files || files.length === 0) return;

            const loadingDiv = document.getElementById('loading-ai');
            const loadingText = document.getElementById('loading-text');
            loadingDiv.classList.remove('hidden');

            for (let i = 0; i < files.length; i++) {
                loadingText.innerText = `Guardando prenda ${i + 1} de ${files.length}...`;
                try {
                    const imageSrc = await compressImage(files[i]);
                    let category = 'superior';
                    let style = 'casual';

                    if (aiModel) {
                        try {
                            const img = new Image();
                            img.src = imageSrc;
                            await new Promise((res) => { img.onload = res; });
                            const preds = await aiModel.classify(img);
                            const text = preds.map(p => p.className.toLowerCase()).join(' ');
                            if (text.includes('shoe') || text.includes('boot') || text.includes('sneaker')) category = 'calzado';
                            else if (text.includes('jean') || text.includes('pant') || text.includes('shorts')) category = 'inferior';
                            else if (text.includes('tie') || text.includes('belt') || text.includes('hat')) category = 'accesorio';
                        } catch (err) {}
                    }

                    const res = await fetch(`${SUPABASE_URL}/rest/v1/prendas`, {
                        method: 'POST',
                        headers: {
                            'apikey': SUPABASE_KEY,
                            'Authorization': `Bearer ${SUPABASE_KEY}`,
                            'Content-Type': 'application/json',
                            'Prefer': 'return=representation'
                        },
                        body: JSON.stringify({ email: currentUserEmail, category, style, image_url: imageSrc })
                    });

                    if (res.ok) {
                        const data = await res.json();
                        const saved = Array.isArray(data) ? data[0] : data;
                        if (saved) {
                            wardrobe.push({ 
                                id: saved.id || Date.now() + Math.random(), 
                                category: saved.category || category, 
                                style: saved.style || style, 
                                image: saved.image_url || imageSrc 
                            });
                        }
                    }
                } catch (err) {
                    console.error("Error al subir archivo", err);
                }
            }

            loadingDiv.classList.add('hidden');
            document.getElementById('item-image').value = '';
            renderWardrobe();
        }

        async function updateCategory(id, newCat) {
            const item = wardrobe.find(i => i.id == id);
            if(item) {
                item.category = newCat;
                renderWardrobe();
                await fetch(`${SUPABASE_URL}/rest/v1/prendas?id=eq.${id}`, {
                    method: 'PATCH',
                    headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ category: newCat })
                });
            }
        }

        async function deleteItem(id) {
            wardrobe = wardrobe.filter(i => i.id !== id);
            renderWardrobe();
            await fetch(`${SUPABASE_URL}/rest/v1/prendas?id=eq.${id}`, {
                method: 'DELETE',
                headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` }
            });
        }

        function renderWardrobe() {
            document.getElementById('count-items').innerText = wardrobe.length;
            const grid = document.getElementById('wardrobe-grid');
            grid.innerHTML = '';

            if(wardrobe.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-10 text-slate-400 text-sm">Tu armario en la nube está vacío. Sube tus fotos.</div>`;
                return;
            }

            wardrobe.forEach(item => {
                grid.innerHTML += `
                    <div class="bg-white p-3 rounded-xl border border-slate-100 shadow-sm relative group space-y-2">
                        <img src="${item.image}" class="w-full h-32 object-cover rounded-lg shadow-sm">
                        <select onchange="updateCategory('${item.id}', this.value)" class="w-full bg-slate-100 text-indigo-600 font-semibold py-1 px-2 rounded border text-xs capitalize cursor-pointer">
                            <option value="superior" ${item.category === 'superior' ? 'selected' : ''}>Superior</option>
                            <option value="inferior" ${item.category === 'inferior' ? 'selected' : ''}>Inferior</option>
                            <option value="calzado" ${item.category === 'calzado' ? 'selected' : ''}>Calzado</option>
                            <option value="accesorio" ${item.category === 'accesorio' ? 'selected' : ''}>Accesorio</option>
                        </select>
                        <button onclick="deleteItem('${item.id}')" class="absolute top-3 right-3 bg-white/80 hover:bg-red-600 hover:text-white text-slate-600 w-7 h-7 rounded-full flex items-center justify-center text-xs shadow transition cursor-pointer"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `;
            });
        }

